{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Error",
      "Ecom.Application.Common.Behaviours": "Error",
      "Ecom.API.Middleware.StructuredLoggingMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationTimeout": 10,
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_SECURITY",
    "Issuer": "MarketPro.API",
    "Audience": "MarketPro.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "EnableTokenRotation": true,
    "TokenRotationGracePeriodMinutes": 2,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 30
  },
  "Password": {
    "BcryptWorkFactor": 10,
    "MinLength": 4,
    "MaxLength": 128,
    "RequireUppercase": false,
    "RequireLowercase": false,
    "RequireDigit": false,
    "RequireSpecialCharacter": false,
    "AllowedSpecialCharacters": "!@#$%^&*()_+-=[]{}|;':\",./<>?"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=marketpro-db-server.postgres.database.azure.com;Port=5432;Database=marketpro_dev;Username=devmarketpro;Password=YOUR_AZURE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;",
    "ReadConnection": "Host=marketpro-db-server.postgres.database.azure.com;Port=5432;Database=marketpro_dev;Username=devmarketpro;Password=YOUR_AZURE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;",
    "WriteConnection": "Host=marketpro-db-server.postgres.database.azure.com;Port=5432;Database=marketpro_dev;Username=devmarketpro;Password=YOUR_AZURE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;",
    "Redis": "localhost:6379,abortConnect=False"
  },
  "SignalR": {
    "UseRedisBackplane": false
  },
  "Otp": {
    "OtpLength": 4,
    "ExpirationSeconds": 60,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "DefaultOtp": "0000"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "MarketPro.API",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317",
    "EnableConsoleExporter": false,
    "EnableGrpcInstrumentation": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Error",
        "Ecom.Application.Common.Behaviours": "Error",
        "Ecom.Infrastructure.Seeding.RoleSeeder": "Error",
        "Ecom.API.Middleware.StructuredLoggingMiddleware": "Warning"
      }
    },
    "EnableFileLogging": false,
    "FilePath": "logs/Ecom-api-.log"
  },
  "SerilogCustom": {
    "EnableFileLogging": false,
    "FilePath": "logs/Ecom-api-.log",
    "SensitiveDataPatterns": [
      "token[=:\\s]+[^\\s&]+",
      "api[_-]?key[=:\\s]+[^\\s&]+",
      "password[=:\\s]+[^\\s&]+",
      "secret[=:\\s]+[^\\s&]+",
      "authorization[=:\\s]+[^\\s&]+",
      "bearer\\s+[^\\s&]+",
      "basic\\s+[^\\s&]+",
      "x-api-key[=:\\s]+[^\\s&]+",
      "x-auth-token[=:\\s]+[^\\s&]+",
      "connectionstring[=:\\s]+[^\\s&]+",
      "conn[=:\\s]+[^\\s&]+"
    ]
  },
  "ApplicationSetting": {
    "SelfUrl": "https://localhost:5000",
    "DataFolderPath": "/ecom-data",
    "StorageFolderPath": "storage"
  },
  "HealthChecks": {
    "UI": {
      "HealthChecksUIEnabled": false,
      "UIPath": "/health-ui"
    }
  }
}

